{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DateFix",
  "mainBinaryName": "DateFix",
  "version": "2.0.0",
  "identifier": "io.github.psybernet.datefix",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DateFix",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Martin Heine",
    "copyright": "© 2024–2026 Martin Heine. MIT License.",
    "category": "Utility",
    "shortDescription": "Rewrite the dates in file names as YYYY-MM-DD",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
